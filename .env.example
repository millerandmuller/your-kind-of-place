# Copy to .env — never commit .env
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Model provider for the agent and the margin-note wording (optional; templates work without)
# anthropic | gemini
LLM_PROVIDER=
LLM_MODEL=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

QLOO_CACHE_DIR=.cache/qloo
RATE_LIMIT_PER_MINUTE=30

# Per-client and global request ceilings; hops = trusted proxies in front (Cloud Run alone: 1)
GLOBAL_LIMIT_PER_MINUTE=240
TRUSTED_PROXY_HOPS=1
